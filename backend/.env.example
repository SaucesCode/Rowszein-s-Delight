# Copy to backend/.env for local development, or set these in the Render dashboard.
# Never commit real values.

# ── Core ────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# ── Database ────────────────────────────────────────────────────────
# Production (DEBUG=False) reads DATABASE_URL.
DATABASE_URL=
# Local development (DEBUG=True) reads these instead.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# ── Sign-in sessions and rate limits ────────────────────────────────
AUTH_SESSION_SIGNING_KEY=
AUTH_SESSION_ENV=
AUTH_RATE_KEYS=
AUTH_RATE_LIMITS={"LA":5,"LI":20,"LR":60,"RR":30}
AUTH_MAX_BUCKET_ROWS=
AUTH_PROXY_MODE=
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=

# ── Photo storage (production) ──────────────────────────────────────
# From the Cloudinary dashboard. When all three are set, donut and ingredient
# photos are stored on Cloudinary; otherwise they are saved to backend/media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rowszein

# ── Logging ─────────────────────────────────────────────────────────
# Sign-in events are always kept; this sets the level for everything else.
LOG_LEVEL=WARNING
